# Team accounts, cross-device favorites, shared Create plays, and statistics.
# Browser-safe values. Never put a service-role key in a VITE_ variable.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_PUBLIC_APP_URL=https://goonsquad.app
# Enable only after 20260729_public_statistics_projection.sql is deployed.
VITE_PUBLIC_STATS_PROJECTION_ENABLED=false

# Server-only username sign-in, account administration, and statistics sync.
# Store these as encrypted Vercel/repository secrets. Never use a VITE_ prefix
# for the service-role key and never commit its value.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
ACCOUNT_OWNER_EMAIL=
PUBLIC_APP_URL=https://goonsquad.app

# Attendance reminders. VAPID enables standards-based browser/PWA push.
# ATTENDANCE_ACTION_SECRET signs short-lived email and push response links.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:attendance@goonsquad.app
ATTENDANCE_ACTION_SECRET=

# Optional email fallback. Verify goonsquad.app with the email provider first.
RESEND_API_KEY=
ATTENDANCE_EMAIL_FROM=Goonsquad <attendance@goonsquad.app>
