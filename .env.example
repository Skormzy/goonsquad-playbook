# Team accounts, cross-device favorites, shared Create plays, and statistics.
# Browser-safe values. Never put a service-role key in a VITE_ variable.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_PUBLIC_APP_URL=https://goonsquad.app

# Server/CI statistics sync only. Store these as encrypted repository secrets,
# never in Vercel client variables or committed environment files.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
